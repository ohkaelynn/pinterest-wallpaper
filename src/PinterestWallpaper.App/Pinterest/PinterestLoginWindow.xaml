<Window x:Class="PinterestWallpaper.App.Pinterest.PinterestLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Sign in to Pinterest — Pinterest Wallpaper"
        Icon="pack://application:,,,/Assets/app.png"
        Width="980"
        Height="740"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#1F232A" Padding="12,8">
            <TextBlock Foreground="White"
                       FontSize="13"
                       Text="Sign in to your personal Pinterest account below (2FA/SSO supported), then close this window. Your password is never seen or stored by this app." />
        </Border>
        <wv2:WebView2 x:Name="WebView" />
    </DockPanel>
</Window>
