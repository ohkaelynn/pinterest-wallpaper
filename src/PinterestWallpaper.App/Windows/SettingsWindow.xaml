<Window x:Class="PinterestWallpaper.App.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pinterest Wallpaper — Settings"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="780"
        Height="610"
        MinWidth="680"
        MinHeight="520"
        Background="#121419"
        Foreground="#F3F5F8"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <SolidColorBrush x:Key="BgCanvas" Color="#121419" />
        <SolidColorBrush x:Key="BgSidebar" Color="#171A21" />
        <SolidColorBrush x:Key="BgCard" Color="#1C2028" />
        <SolidColorBrush x:Key="BgInput" Color="#12151B" />
        <SolidColorBrush x:Key="BorderSubtle" Color="#2A303C" />
        <SolidColorBrush x:Key="TextPrimary" Color="#F3F5F8" />
        <SolidColorBrush x:Key="TextMuted" Color="#8E98A8" />
        <SolidColorBrush x:Key="AccentBrush" Color="#E60023" />
        <SolidColorBrush x:Key="AccentHover" Color="#FF1F42" />

        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BgCard}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style x:Key="HelperText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="NavButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#C4CBD6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Root" Background="Transparent" CornerRadius="8" Padding="12,10">
                            <Grid>
                                <Border x:Name="Indicator" Width="3" Height="16" CornerRadius="2"
                                        Background="{StaticResource AccentBrush}"
                                        HorizontalAlignment="Left" Margin="-6,0,0,0" Visibility="Collapsed" />
                                <ContentPresenter VerticalAlignment="Center" Margin="6,0,0,0" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#222732" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#252B37" />
                                <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource BgInput}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="CaretBrush" Value="{StaticResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="18,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#252A34" />
            <Setter Property="Foreground" Value="#F3F5F8" />
            <Setter Property="BorderBrush" Value="#343C4A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2F3643" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource BgSidebar}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,1,0" Padding="14,18">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="6,0,0,22">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="22" Height="22" CornerRadius="6" Background="#7C3AED" Margin="0,0,8,0">
                            <TextBlock Text="PW" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Pinterest Wallpaper" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="Local-first desktop swapper" FontSize="11.5" Foreground="{StaticResource TextMuted}" Margin="18,2,0,0" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="6,12,6,0">
                    <TextBlock x:Name="SidebarStatusText" Text="0 unseen cached" FontSize="11.5" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel>
                    <RadioButton x:Name="NavSources" Content="Sources &amp; Save" Style="{StaticResource NavButton}" IsChecked="True" Checked="OnNavChanged" />
                    <RadioButton x:Name="NavRotation" Content="Rotation &amp; Display" Style="{StaticResource NavButton}" Checked="OnNavChanged" />
                    <RadioButton x:Name="NavFilters" Content="Filters &amp; Limits" Style="{StaticResource NavButton}" Checked="OnNavChanged" />
                    <RadioButton x:Name="NavAccount" Content="Account &amp; Status" Style="{StaticResource NavButton}" Checked="OnNavChanged" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Content + Footer -->
        <DockPanel Grid.Column="1" Background="{StaticResource BgCanvas}">
            <Border DockPanel.Dock="Bottom" Background="#171A21" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,1,0,0" Padding="20,12">
                <DockPanel>
                    <TextBlock Text="Changes apply immediately on Save." VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" FontSize="12" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="OnCancelClick" />
                        <Button Content="Save Changes" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="OnSaveClick" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="22,20">
                <Grid>
                    <!-- PAGE 1: Sources & Save -->
                    <StackPanel x:Name="PageSources">
                        <TextBlock Text="Sources &amp; Pinterest Actions" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,14" />

                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="Pinterest Boards" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="Paste one board URL per line (must be https://...pinterest.com/...). Supports your private/secret boards when signed in." Style="{StaticResource HelperText}" />
                                <TextBox x:Name="BoardsBox" AcceptsReturn="True" Height="82" VerticalScrollBarVisibility="Auto" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="Search Terms &amp; Home Feed" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="Enter one search query per line (e.g. 'cat wallpaper', 'minimalist landscape 4k')." Style="{StaticResource HelperText}" />
                                <TextBox x:Name="SearchesBox" AcceptsReturn="True" Height="82" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10" />
                                <CheckBox x:Name="HomeFeedCheck" Content="Also pull from my personal Pinterest Home Feed" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="Like &amp; Save to Board" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="'Like on Pinterest' and 'Save to Pinterest Board' are separate actions in your desktop right-click &amp; tray menus." Style="{StaticResource HelperText}" />
                                <CheckBox x:Name="BackgroundSaveCheck" Content="Run Like &amp; Save silently in the background (uncheck to open pin in browser)" Margin="0,0,0,10" />
                                <TextBlock Text="Target Board Name for 'Save to Pinterest Board'" FontWeight="Medium" Margin="0,0,0,4" />
                                <TextBlock Text="Leave blank to save to Pinterest's default 'My Saves', or type an exact board name from your account." Style="{StaticResource HelperText}" />
                                <TextBox x:Name="DefaultBoardBox" Height="32" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- PAGE 2: Rotation & Display -->
                    <StackPanel x:Name="PageRotation" Visibility="Collapsed">
                        <TextBlock Text="Rotation &amp; Display" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,14" />

                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="Schedule &amp; Monitors" Style="{StaticResource SectionTitle}" />
                                <CheckBox x:Name="RotationEnabledCheck" Content="Enable automatic timed wallpaper rotation" Margin="0,4,0,12" />

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="150" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="38" />
                                        <RowDefinition Height="38" />
                                        <RowDefinition Height="38" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Interval (minutes)" VerticalAlignment="Center" />
                                    <TextBox x:Name="IntervalBox" Grid.Row="0" Grid.Column="1" Height="30" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Timing Jitter (%)" VerticalAlignment="Center" />
                                    <TextBox x:Name="JitterBox" Grid.Row="1" Grid.Column="1" Height="30" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Wallpaper Fit Mode" VerticalAlignment="Center" />
                                    <ComboBox x:Name="FitModeCombo" Grid.Row="2" Grid.Column="1" Height="30" VerticalContentAlignment="Center" />
                                </Grid>

                                <CheckBox x:Name="PerMonitorCheck" Content="Show a different wallpaper on each monitor" />
                                <CheckBox x:Name="PauseBatteryCheck" Content="Pause timed rotation while on laptop battery" />
                                <CheckBox x:Name="PauseFullscreenCheck" Content="Pause timed rotation during fullscreen apps or games" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="Windows Integration" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="Uses HKEY_CURRENT_USER only — no administrator rights required." Style="{StaticResource HelperText}" />
                                <CheckBox x:Name="ContextMenuCheck" Content="Show 'Pinterest Wallpaper' in desktop right-click menu" />
                                <CheckBox x:Name="StartWithWindowsCheck" Content="Start automatically when signing into Windows" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- PAGE 3: Filters & Limits -->
                    <StackPanel x:Name="PageFilters" Visibility="Collapsed">
                        <TextBlock Text="Filters &amp; Gentle Sync Limits" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,14" />

                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="Image Quality &amp; Aspect Filters" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="Low-resolution, wrong-orientation, and near-duplicate pins are filtered out before entering your wallpaper pool." Style="{StaticResource HelperText}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="100" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="38" />
                                        <RowDefinition Height="38" />
                                        <RowDefinition Height="38" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Min Width (px)" VerticalAlignment="Center" />
                                    <TextBox x:Name="MinWidthBox" Grid.Row="0" Grid.Column="1" Height="30" />
                                    <TextBlock Grid.Row="0" Grid.Column="3" Text="Min Height (px)" VerticalAlignment="Center" />
                                    <TextBox x:Name="MinHeightBox" Grid.Row="0" Grid.Column="4" Height="30" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Aspect Ratio Min" VerticalAlignment="Center" />
                                    <TextBox x:Name="AspectMinBox" Grid.Row="1" Grid.Column="1" Height="30" />
                                    <TextBlock Grid.Row="1" Grid.Column="3" Text="Aspect Ratio Max" VerticalAlignment="Center" />
                                    <TextBox x:Name="AspectMaxBox" Grid.Row="1" Grid.Column="4" Height="30" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Orientation" VerticalAlignment="Center" />
                                    <ComboBox x:Name="OrientationCombo" Grid.Row="2" Grid.Column="1" Height="30" VerticalContentAlignment="Center" />
                                </Grid>
                                <CheckBox x:Name="DedupeCheck" Content="Skip duplicate / near-duplicate reposts (perceptual hash)" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="Cache &amp; Rate-Limit Governor" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="Keeps Pinterest traffic natural and non-aggressive. Swapping wallpapers always reads from your local cache." Style="{StaticResource HelperText}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="210" />
                                        <ColumnDefinition Width="130" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="36" />
                                        <RowDefinition Height="36" />
                                        <RowDefinition Height="36" />
                                        <RowDefinition Height="36" />
                                        <RowDefinition Height="36" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Max Local Cache (MB)" VerticalAlignment="Center" />
                                    <TextBox x:Name="MaxCacheBox" Grid.Row="0" Grid.Column="1" Height="28" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Low-Water Refill Trigger (unseen)" VerticalAlignment="Center" />
                                    <TextBox x:Name="LowWaterBox" Grid.Row="1" Grid.Column="1" Height="28" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Target Local Pool Size" VerticalAlignment="Center" />
                                    <TextBox x:Name="TargetPoolBox" Grid.Row="2" Grid.Column="1" Height="28" />

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Min Sync Cooldown (min, >=15)" VerticalAlignment="Center" />
                                    <TextBox x:Name="CooldownBox" Grid.Row="3" Grid.Column="1" Height="28" />

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Max Syncs Per Day (1–24)" VerticalAlignment="Center" />
                                    <TextBox x:Name="MaxSyncsBox" Grid.Row="4" Grid.Column="1" Height="28" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- PAGE 4: Account & Status -->
                    <StackPanel x:Name="PageAccount" Visibility="Collapsed">
                        <TextBlock Text="Account &amp; Sync Status" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,14" />

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0">
                                <StackPanel>
                                    <TextBlock Text="CACHED" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" />
                                    <TextBlock x:Name="StatTotalText" Text="0" FontSize="26" FontWeight="Bold" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource CardBorder}" Margin="0">
                                <StackPanel>
                                    <TextBlock Text="UNSEEN READY" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" />
                                    <TextBlock x:Name="StatUnseenText" Text="0" FontSize="26" FontWeight="Bold" Foreground="#4ADE80" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="4" Style="{StaticResource CardBorder}" Margin="0">
                                <StackPanel>
                                    <TextBlock Text="SYNCS (24H)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" />
                                    <TextBlock x:Name="StatSyncsText" Text="0 / 4" FontSize="26" FontWeight="Bold" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="Rate-Limit Governor" Style="{StaticResource SectionTitle}" />
                                <TextBlock x:Name="StatusText" Foreground="#CBD3DF" TextWrapping="Wrap" Margin="0,4,0,14" />

                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Sign in to Pinterest..." Style="{StaticResource PrimaryButton}" Margin="0,0,10,0" Click="OnSignInClick" />
                                    <Button Content="Sync Now" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" Click="OnSyncNowClick" />
                                    <Button Content="Sign Out &amp; Clear Session" Style="{StaticResource SecondaryButton}" Click="OnSignOutClick" />
                                </StackPanel>
                                <TextBlock Text="Your Pinterest login stays inside a local Microsoft Edge WebView2 profile (%LOCALAPPDATA%\PinterestWallpaper\WebView2). Passwords are never seen or stored."
                                           Style="{StaticResource HelperText}" Margin="0,12,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</Window>
