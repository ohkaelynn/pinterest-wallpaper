<Window x:Class="PinterestWallpaper.App.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pinterest Wallpaper Settings"
        Width="600"
        Height="560"
        MinWidth="520"
        MinHeight="480"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" Width="90" Height="30" Margin="0,0,8,0" Click="OnCancelClick" />
            <Button Content="Save" Width="100" Height="30" IsDefault="true" Click="OnSaveClick" />
        </StackPanel>

        <TabControl>
            <TabItem Header="Sources &amp; Save">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                    <StackPanel>
                        <TextBlock Text="Pinterest Board URLs (one per line, https://www.pinterest.com/...):" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBox x:Name="BoardsBox" AcceptsReturn="True" Height="85" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10" />

                        <TextBlock Text="Search Terms (one per line):" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBox x:Name="SearchesBox" AcceptsReturn="True" Height="85" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10" />

                        <CheckBox x:Name="HomeFeedCheck" Content="Include Personal Home Feed" Margin="0,0,0,14" />

                        <Separator Margin="0,0,0,10" />
                        <TextBlock Text="Save / Pin to Pinterest" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <CheckBox x:Name="BackgroundSaveCheck" Content="Save &amp; like silently in background (otherwise opens pin in browser)" Margin="0,0,0,6" />
                        <CheckBox x:Name="LikeWhenSavingCheck" Content="Also click Like (Heart) when saving a wallpaper" Margin="0,0,0,8" />

                        <TextBlock Text="Default Save Board Name (leave blank for Pinterest's default 'My Saves'):" Margin="0,0,0,4" />
                        <TextBox x:Name="DefaultBoardBox" Height="26" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Rotation &amp; Display">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                    <StackPanel>
                        <CheckBox x:Name="RotationEnabledCheck" Content="Enable automatic wallpaper rotation" Margin="0,0,0,10" />

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30" />
                                <RowDefinition Height="30" />
                                <RowDefinition Height="30" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Interval (minutes):" VerticalAlignment="Center" />
                            <TextBox x:Name="IntervalBox" Grid.Row="0" Grid.Column="1" Height="24" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Timing Jitter (%):" VerticalAlignment="Center" />
                            <TextBox x:Name="JitterBox" Grid.Row="1" Grid.Column="1" Height="24" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Fit Mode:" VerticalAlignment="Center" />
                            <ComboBox x:Name="FitModeCombo" Grid.Row="2" Grid.Column="1" Height="24" />
                        </Grid>

                        <CheckBox x:Name="PerMonitorCheck" Content="Use a different wallpaper on each monitor" Margin="0,0,0,6" />
                        <CheckBox x:Name="PauseBatteryCheck" Content="Pause timed rotation while on battery" Margin="0,0,0,6" />
                        <CheckBox x:Name="PauseFullscreenCheck" Content="Pause timed rotation during fullscreen apps/games" Margin="0,0,0,12" />

                        <Separator Margin="0,0,0,10" />
                        <TextBlock Text="Windows Integration (No Admin Required)" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <CheckBox x:Name="ContextMenuCheck" Content="Show 'Pinterest Wallpaper' in desktop right-click menu" Margin="0,0,0,6" />
                        <CheckBox x:Name="StartWithWindowsCheck" Content="Start automatically when signing into Windows" Margin="0,0,0,6" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Filters &amp; Limits">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="140" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30" />
                            <RowDefinition Height="30" />
                            <RowDefinition Height="30" />
                            <RowDefinition Height="30" />
                            <RowDefinition Height="30" />
                            <RowDefinition Height="30" />
                            <RowDefinition Height="30" />
                            <RowDefinition Height="30" />
                            <RowDefinition Height="30" />
                            <RowDefinition Height="30" />
                            <RowDefinition Height="30" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Min Width (px):" VerticalAlignment="Center" />
                        <TextBox x:Name="MinWidthBox" Grid.Row="0" Grid.Column="1" Height="24" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Min Height (px):" VerticalAlignment="Center" />
                        <TextBox x:Name="MinHeightBox" Grid.Row="1" Grid.Column="1" Height="24" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Orientation:" VerticalAlignment="Center" />
                        <ComboBox x:Name="OrientationCombo" Grid.Row="2" Grid.Column="1" Height="24" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Min Aspect Ratio:" VerticalAlignment="Center" />
                        <TextBox x:Name="AspectMinBox" Grid.Row="3" Grid.Column="1" Height="24" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Max Aspect Ratio:" VerticalAlignment="Center" />
                        <TextBox x:Name="AspectMaxBox" Grid.Row="4" Grid.Column="1" Height="24" />

                        <CheckBox x:Name="DedupeCheck" Grid.Row="5" Grid.ColumnSpan="2" Content="Skip duplicate / near-duplicate images" VerticalAlignment="Center" />

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Max Local Cache (MB):" VerticalAlignment="Center" />
                        <TextBox x:Name="MaxCacheBox" Grid.Row="6" Grid.Column="1" Height="24" />

                        <TextBlock Grid.Row="7" Grid.Column="0" Text="Low-Water Mark (unseen):" VerticalAlignment="Center" />
                        <TextBox x:Name="LowWaterBox" Grid.Row="7" Grid.Column="1" Height="24" />

                        <TextBlock Grid.Row="8" Grid.Column="0" Text="Target Pool Size:" VerticalAlignment="Center" />
                        <TextBox x:Name="TargetPoolBox" Grid.Row="8" Grid.Column="1" Height="24" />

                        <TextBlock Grid.Row="9" Grid.Column="0" Text="Min Sync Cooldown (min, >=60):" VerticalAlignment="Center" />
                        <TextBox x:Name="CooldownBox" Grid.Row="9" Grid.Column="1" Height="24" />

                        <TextBlock Grid.Row="10" Grid.Column="0" Text="Max Syncs Per Day (1-12):" VerticalAlignment="Center" />
                        <TextBox x:Name="MaxSyncsBox" Grid.Row="10" Grid.Column="1" Height="24" />
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Account &amp; Status">
                <StackPanel Margin="12">
                    <TextBlock Text="Local Pool &amp; Rate-Limit Status" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="0,0,0,16" />

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="Sign in to Pinterest..." Width="160" Height="30" Margin="0,0,8,0" Click="OnSignInClick" />
                        <Button Content="Sync Now" Width="110" Height="30" Margin="0,0,8,0" Click="OnSyncNowClick" />
                    </StackPanel>

                    <Button Content="Sign Out &amp; Clear Local Session" Width="210" Height="30" HorizontalAlignment="Left" Click="OnSignOutClick" />
                    <TextBlock Text="Clearing session deletes the local WebView2 profile folder (%LOCALAPPDATA%\PinterestWallpaper\WebView2)."
                               Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" />
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
